{
	"manifest_version": 3,
	"version": "2026.5.20.1",
	"name": "Guarabira Educa",
	"short_name": "guarabira-educa",
	"description": "Auxilia os professores do município de Guarabira agilizando a edição da plataforma Guarabira Educa.",
	"homepage_url" : "https://github.com/edusantana/guarabira-educa",
	"permissions": [
		"storage"	
	],
	"icons": {
		"16": "icon16.png",
		"48": "icon48.png",
		"128": "icon128.png"
	},
	"options_page": "options.html",
	"content_scripts": [
		{
			"matches": [
				"https://guarabira-educa.ids.inf.br/*"
			],
			"js": [
				"educa.js"
			]
		}
	]
}
